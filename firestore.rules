rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Subjects - public read, admin only write
    match /subjects/{subject} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Students - public read, admin only write
    match /students/{student} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Progress tracking - public read, admin only write
    match /progress/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // All other collections (videos, files, assessments, admins...)
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
