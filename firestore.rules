rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: is the signed-in Firebase user an admin (has a doc in admin/<uid>)?
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ─── SUBJECTS ───────────────────────────────────────────────
    // Public read (students need it to browse). Write: admin only.
    match /subjects/{subject} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── STUDENTS ──────────────────────────────────────────────
    // Open access here is the intended design, not a pending migration.
    // Students have no Firebase Auth account: a student authenticates by
    // username + password read straight out of this collection (see
    // verifyStudentCredentials in firestore.ts). That comparison cannot be done
    // server-side, so an anonymous visitor must be able to read this collection.
    //
    // Stated plainly, because it is the trade-off: `password` is stored in
    // plaintext, and this rule makes every student's password readable by
    // anything that can read /students. Locking reads down to isAdmin() alone
    // breaks student login and device registration outright.
    match /students/{student} {
      allow read: if isAdmin() || request.auth == null;
      allow write: if isAdmin() || request.auth == null;
    }

    // ─── ADMINS ────────────────────────────────────────────────
    // Highly sensitive. Read/write admin only.
    match /admins/{admin} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

// ─── STATS / SETTINGS / PROGRESS ───────────────────────────
// stats: reads are admin-only. Writes are open on purpose: plays / watch-time /
// visits are counted from the visitor's browser, which has no Firebase Auth
// session for a student, so this sits at the same in-app trust level as
// /students. The consequence is that anyone may write counters here; what is
// actually read back (the analytics) stays admin-only.
    match /stats/{doc} {
      allow read: if isAdmin();
      allow write: if true;
    }
    match /settings/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /progress/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── CONTENT (videos, files, assessments) ───────────────────
    // Public read (students need it). Write: admin only.
    match /videos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /files/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /assessments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── CHALLENGE (quizzes + leaderboards) ───────────────────
    // quizzes: public read, admin write. quizResults / studentMedals:
    // public read (leaderboards) + open write (students authenticate
    // in-app without Firebase Auth — same trust level as /students).
    match /quizzes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /quizResults/{doc} {
      allow read: if true;
      allow write: if true;
    }
    match /studentMedals/{doc} {
      allow read: if true;
      allow write: if true;
    }
    match /materialQuizzes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /materialQuizResults/{doc} {
      allow read: if true;
      allow write: if true;
    }
    // Students' own "finished" marks on interactive quizzes. Students sign in
    // in-app (no Firebase Auth), so reads/writes stay open at the same trust
    // level as /materialQuizResults. Doc id is `${quizId}_${username}`.
    match /materialQuizDone/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // ─── COUNTERS (atomic order counters per subject) ──────────
    // Read/write admin only.
    match /counters/{key} {
      allow read, write: if isAdmin();
    }

    // ─── FALLBACK (safety) ─────────────────────────────────────
    // Any future collection: default DENY. Never world-writable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}